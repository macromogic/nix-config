# macOS-only bits, carried over from the existing ~/.zshrc.
# Homebrew still owns casks and anything not yet migrated.
{ lib, pkgs, ... }:

{
  home.sessionVariables = {
    IMAGEIO_FREEIMAGE_LIB = "/opt/homebrew/opt/freeimage/lib/libfreeimage.dylib";
    NVM_DIR = "$HOME/.nvm";
  };

  # AeroSpace itself comes from Homebrew; only its config lives here.
  # auto-reload-config misses home-manager's symlink swap, so a switch would
  # leave the running server on the old config; reload it here instead.
  xdg.configFile."aerospace/aerospace.toml" = {
    source = ./../../dotfiles/aerospace.toml;
    onChange = ''
      if [ -x /opt/homebrew/bin/aerospace ]; then
        run /opt/homebrew/bin/aerospace reload-config || true
      fi
    '';
  };
  # Raycast script command listing the AeroSpace keys, regenerated from the
  # config. Raycast needs ~/.config/raycast/scripts added once under
  # Settings > Extensions > Script Commands.
  xdg.configFile."raycast/scripts/aerospace-keys.sh" = {
    executable = true;
    source = pkgs.runCommand "aerospace-keys.sh" { nativeBuildInputs = [ pkgs.python3 ]; } ''
      python3 ${./../../scripts/aerospace-cheatsheet.py} ${./../../dotfiles/aerospace.toml} > $out
    '';
  };
  # Same for Neovim, but the keys come from the LazyVim clone and its plugins,
  # which the build can't see, so the script asks a headless nvim each time it
  # runs. The CMake and Rust plugins only bind keys inside such projects; the
  # extra runs in fake projects pick those up.
  xdg.configFile."raycast/scripts/nvim-keys.sh".source = pkgs.writeScript "nvim-keys.sh" ''
    #!${pkgs.bash}/bin/bash
    # Raycast script command, generated by home/platforms/darwin.nix from
    # scripts/nvim-cheatsheet.{lua,py}; edit those, not this file.
    #
    # @raycast.schemaVersion 1
    # @raycast.title Neovim Keys
    # @raycast.mode fullOutput
    # @raycast.packageName Neovim
    # @raycast.icon ⌨️
    # @raycast.description Key bindings from the LazyVim config

    # Raycast's PATH lacks the tools plugins shell out to, such as git.
    export PATH="$HOME/.nix-profile/bin:$PATH"
    tmp=$(${pkgs.coreutils}/bin/mktemp -d)
    trap '${pkgs.coreutils}/bin/rm -rf "$tmp"' EXIT
    ${pkgs.coreutils}/bin/mkdir "$tmp/base" "$tmp/cmake" "$tmp/rust"
    : >"$tmp/cmake/CMakeLists.txt"
    : >"$tmp/rust/Cargo.toml"
    for dir in base cmake rust; do
      (cd "$tmp/$dir" && ${pkgs.neovim}/bin/nvim --headless -i NONE \
        -c "luafile ${./../../scripts/nvim-cheatsheet.lua}" -c qa >"$tmp/$dir.json" 2>/dev/null) &
    done
    wait
    ${pkgs.python3}/bin/python3 ${./../../scripts/nvim-cheatsheet.py} "$tmp/base.json" \
      "CMake projects=$tmp/cmake.json" "Rust projects=$tmp/rust.json"
  '';

  # Login shells that never read .zshrc still need Homebrew.
  programs.zsh.profileExtra = ''
    eval "$(/opt/homebrew/bin/brew shellenv)"
  '';

  programs.zsh.initContent = lib.mkAfter ''
    eval "$(/opt/homebrew/bin/brew shellenv)"
    export PATH="/opt/homebrew/opt/bzip2/bin:$PATH"

    export PATH="$HOME/.jenv/bin:$PATH"
    eval "$(jenv init -)"

    __conda_setup="$('/opt/homebrew/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
      eval "$__conda_setup"
    elif [ -f "/opt/homebrew/anaconda3/etc/profile.d/conda.sh" ]; then
      . "/opt/homebrew/anaconda3/etc/profile.d/conda.sh"
    else
      export PATH="/opt/homebrew/anaconda3/bin:$PATH"
    fi
    unset __conda_setup

    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

    # brew shellenv prepends /opt/homebrew/bin; put Nix back in front so
    # tools managed here win over leftover brew duplicates.
    export PATH="$HOME/.nix-profile/bin:$PATH"
  '';
}
